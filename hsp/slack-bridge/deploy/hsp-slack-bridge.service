[Unit]
Description=HSP Slack bridge (Socket Mode -> OpenMausBot guarded routes)
After=network-online.target openmausbot-hsp.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hsp-slack
Group=hsp-slack
WorkingDirectory=/opt/hsp-slack-bridge
ExecStart=/usr/local/bin/node /opt/hsp-slack-bridge/bridge.mjs
Environment=NODE_ENV=production
Environment=BRIDGE_CONFIG=/etc/hsp-slack-bridge/config.json
Environment=BRIDGE_STATE=/var/lib/hsp-slack-bridge/state.json
# Secrets arrive as systemd credentials only: relay.token and tokens_<bot>.json (from the tokens directory).
LoadCredential=relay.token:/etc/hsp-slack-bridge/relay.token
LoadCredential=tokens:/etc/hsp-slack-bridge/tokens
StateDirectory=hsp-slack-bridge
StateDirectoryMode=0755
Restart=always
RestartSec=10
# Hardening: outbound only (Slack wss + 127.0.0.1:8870), no listening port, no writes outside its state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
