# /etc/omb-hsp-deploy/deploy.env  (owner root, mode 0644: no secrets here)
# Read as root by /usr/local/sbin/omb-hsp-deploy and by health-check.sh.

# systemd unit; its drop-in is /etc/systemd/system/$SERVICE.service.d/team.conf
SERVICE=openmausbot-hsp
# Where the hspNN folders live, no trailing slash
BASE_DIR=/opt/hsp-openmausbot
# The user the service runs as; new folders are installed as this user
SERVICE_USER=omb-hsp
# npm that installs new folders (run as SERVICE_USER). Use the same Node
# install the service's ExecStart uses: `command -v npm` as that user.
NPM_BIN=/usr/bin/npm
# npm package installed into each folder
PACKAGE=openmausbot

# Health checks
PORT=8890
#SITE_URL=http://127.0.0.1:8890/
#API_URL=http://127.0.0.1:8890/api/health
START_TIMEOUT=120
SETTLE_SECONDS=60
# Seconds each script in checks.d may run
CHECK_TIMEOUT=180
